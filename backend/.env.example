# Populate securely on your server. This file contains no real credentials.
RAZORPAY_KEY_ID=rzp_test_REPLACE
RAZORPAY_KEY_SECRET=REPLACE
RAZORPAY_WEBHOOK_SECRET=REPLACE_WITH_A_SEPARATE_RANDOM_SECRET
RAZORPAY_ACCOUNT_ID=acc_REPLACE
GOOGLE_WEB_CLIENT_ID=REPLACE.apps.googleusercontent.com
BILLING_PLANS_FILE=/absolute/path/plans.local.json
BILLING_DATABASE=/absolute/persistent/path/billing.sqlite
BILLING_CATALOG_VERSION=1
BILLING_CHECKOUT_ENABLED=false
BILLING_TERMS_URL=https://your-domain.example/terms
BILLING_PRIVACY_URL=https://your-domain.example/privacy
BILLING_SUPPORT_URL=https://your-domain.example/support
