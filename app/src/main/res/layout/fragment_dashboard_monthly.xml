<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="@style/ThemeOverlay.SpendTracker.Dashboard"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dashboard_dark_background"
    android:orientation="vertical"
    android:paddingTop="4dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingHorizontal="12dp" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="Year in review" android:textSize="17sp" android:fontFamily="sans-serif-medium"
            android:textColor="@color/dashboard_text_primary" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_share_receipt"
            style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content"
            android:layout_height="48dp" android:text="Share report" android:textSize="12sp"
            android:contentDescription="Share yearly report" app:icon="@drawable/ic_symbol_share" app:iconSize="18dp" />
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_transactions"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="12dp"
        android:paddingBottom="16dp" />
</LinearLayout>
