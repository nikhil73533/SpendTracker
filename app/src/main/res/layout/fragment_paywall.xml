<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/dark_background">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/premium_close"
        android:layout_width="match_parent" android:layout_height="?attr/actionBarSize" android:background="@color/dark_surface"
        app:navigationIcon="@android:drawable/ic_menu_close_clear_cancel" app:title="@string/title_premium" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/premium_subtitle"
                android:textColor="@color/text_secondary" android:textSize="17sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp"
                android:text="@string/premium_benefits"
                android:textColor="@color/white" android:lineSpacingExtra="8dp" android:textSize="16sp" />
            <ProgressBar android:id="@+id/premium_progress" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal" android:layout_marginTop="28dp" />
            <TextView android:id="@+id/premium_status" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:textColor="@color/text_secondary" android:gravity="center" />
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/premium_plans" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="16dp" android:nestedScrollingEnabled="false" />
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:background="@color/dark_surface">
        <com.google.android.material.button.MaterialButton android:id="@+id/premium_continue" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:enabled="false" android:text="@string/premium_continue" />
        <com.google.android.material.button.MaterialButton android:id="@+id/premium_restore" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/premium_restore" style="@style/Widget.Material3.Button.OutlinedButton" />
        <com.google.android.material.button.MaterialButton android:id="@+id/premium_later" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/premium_maybe_later" style="@style/Widget.Material3.Button.TextButton" />
    </LinearLayout>
</LinearLayout>
