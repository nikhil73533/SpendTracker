<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:theme="@style/ThemeOverlay.SpendTracker.Dashboard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingTop="18dp"
    android:paddingBottom="10dp"
    android:background="@color/dashboard_dark_background"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/tv_day_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/dashboard_text_primary"
        tools:text="24" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_day_of_week"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:paddingHorizontal="4dp"
            android:paddingVertical="1dp"
            android:background="@android:color/transparent"
            android:textColor="@color/dashboard_text_primary"
            tools:text="Fri" />

        <TextView
            android:id="@+id/tv_month_year"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="10sp"
            android:textColor="@color/dashboard_text_secondary"
            tools:text="07.2026" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_day_income"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:textColor="@color/dashboard_income_blue"
        android:textSize="14sp"
        tools:text="₹ 0.00" />

    <TextView
        android:id="@+id/tv_day_transfer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:textColor="@color/dashboard_brand_transfer"
        android:textSize="14sp"
        android:visibility="gone"
        tools:text="↔ ₹ 500"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tv_day_expense"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/dashboard_expense_red"
        android:textSize="14sp"
        tools:text="₹ 30.00" />
</LinearLayout>
