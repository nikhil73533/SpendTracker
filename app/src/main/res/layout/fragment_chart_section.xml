<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Dynamic Chart Section -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <com.github.mikephil.charting.charts.PieChart
                android:id="@+id/pie_chart_main"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintWidth_percent="0.8"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Stats List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:layout_marginBottom="24dp"
            tools:listitem="@layout/item_category_stat" />

        <!-- Line Chart for Trends -->
        <TextView
            android:id="@+id/tv_trends_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Monthly Trends"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:alpha="0.7"
            android:layout_marginBottom="8dp"/>

        <com.github.mikephil.charting.charts.LineChart
            android:id="@+id/line_chart"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginBottom="24dp" />

        <!-- Weekend vs Weekday Bar Chart -->
        <TextView
            android:id="@+id/tv_weekend_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Weekend vs Weekday"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:alpha="0.7"
            android:layout_marginBottom="8dp"/>

        <com.github.mikephil.charting.charts.BarChart
            android:id="@+id/bar_chart_weekend"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginBottom="24dp" />

        <!-- Bank Totals Bar Chart -->
        <TextView
            android:id="@+id/tv_banks_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bank-wise Distribution"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:alpha="0.7"
            android:layout_marginBottom="8dp"/>

        <com.github.mikephil.charting.charts.BarChart
            android:id="@+id/bar_chart_banks"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginBottom="24dp" />

        <!-- Source Type Pie Chart -->
        <TextView
            android:id="@+id/tv_source_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Credit Card / Bank / Cash"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:alpha="0.7"
            android:layout_marginBottom="8dp"/>

        <com.github.mikephil.charting.charts.PieChart
            android:id="@+id/pie_chart_source"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:layout_marginBottom="8dp" />

        <!-- Legend for Source Pie Chart -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_source_stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:layout_marginBottom="24dp"
            tools:listitem="@layout/item_category_stat" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
