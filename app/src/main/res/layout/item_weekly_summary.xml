<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:theme="@style/ThemeOverlay.SpendTracker.Dashboard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp"
    android:gravity="center_vertical"
    android:background="@color/dashboard_dark_surface_variant">

    <TextView
        android:id="@+id/tv_week_range"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="@color/dashboard_text_secondary"
        android:textSize="14sp"
        tools:text="26.07 ~ 01.08" />

    <TextView
        android:id="@+id/tv_week_income"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="24dp"
        android:textColor="@color/dashboard_income_blue"
        android:textSize="14sp"
        tools:text="₹ 0.00" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_week_expense"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/dashboard_expense_red"
            android:textSize="14sp"
            tools:text="₹ 8,087.00" />

        <TextView
            android:id="@+id/tv_week_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/dashboard_text_secondary"
            android:textSize="10sp"
            tools:text="-₹ 8,087.00" />
    </LinearLayout>

</LinearLayout>
