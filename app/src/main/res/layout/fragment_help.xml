<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/dark_background">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/help_toolbar"
        android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
        android:background="@color/dark_surface" app:navigationIcon="@android:drawable/ic_menu_revert"
        app:title="@string/title_help" />
    <androidx.appcompat.widget.SearchView android:id="@+id/help_search"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="16dp"
        app:queryHint="@string/hint_search_help" />
    <com.google.android.material.chip.ChipGroup android:id="@+id/help_categories"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp" android:layout_marginBottom="12dp" app:singleSelection="true"
        app:chipSpacingHorizontal="8dp" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/help_list"
            android:layout_width="match_parent" android:layout_height="match_parent" android:paddingStart="16dp"
            android:paddingEnd="16dp" android:clipToPadding="false" />
        <TextView android:id="@+id/help_empty" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center" android:text="@string/help_empty" android:textColor="@color/text_secondary"
            android:visibility="gone" />
    </FrameLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
        android:padding="16dp" android:background="@color/dark_surface">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/help_online_heading"
            android:textColor="@color/white" android:textStyle="bold" />
        <com.google.android.material.button.MaterialButton android:id="@+id/help_online" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/help_online" />
        <com.google.android.material.button.MaterialButton android:id="@+id/help_feedback" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/send_feedback"
            style="@style/Widget.Material3.Button.OutlinedButton" />
    </LinearLayout>
</LinearLayout>
