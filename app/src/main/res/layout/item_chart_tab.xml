<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:gravity="center" android:paddingVertical="8dp">
    <TextView android:id="@+id/chart_tab_label"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center" android:textColor="@color/text_secondary" android:textSize="13sp" />
    <androidx.appcompat.widget.AppCompatTextView android:id="@+id/chart_tab_amount"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:gravity="center"
        android:maxLines="1" android:textColor="@color/white" android:textSize="14sp"
        app:autoSizeTextType="uniform" app:autoSizeMinTextSize="9sp"
        app:autoSizeMaxTextSize="14sp" app:autoSizeStepGranularity="1sp" />
</LinearLayout>
