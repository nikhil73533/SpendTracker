<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp"
    android:clickable="true" android:focusable="true" app:cardBackgroundColor="@color/dark_surface"
    app:cardCornerRadius="12dp" android:checkable="true" app:strokeColor="@color/audit_green" app:strokeWidth="2dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <TextView android:id="@+id/plan_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/white" android:textStyle="bold" android:textSize="17sp" />
        <TextView android:id="@+id/plan_price" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:textColor="@color/audit_green" android:textStyle="bold" android:textSize="20sp" />
        <TextView android:id="@+id/plan_period" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:textColor="@color/text_secondary" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
