<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Black foundation throughout; light control accents remain readable on dark surfaces. -->
    <style name="Theme.SpendTracker" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/dark_background</item>
        <item name="android:colorBackground">@color/dark_background</item>
        <item name="colorSurface">@color/dark_surface</item>
        <item name="colorSurfaceContainer">@color/dark_surface_variant</item>
        <item name="colorSurfaceContainerHigh">@color/dark_surface_variant</item>
        <item name="colorSurfaceContainerHighest">@color/dark_surface_variant</item>
        <item name="colorSurfaceVariant">@color/dark_surface_variant</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/brand_on_primary</item>
        <item name="colorPrimaryContainer">@color/brand_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/brand_on_primary_container</item>
        <item name="colorSecondary">@color/brand_secondary</item>
        <item name="colorOnSecondary">@color/dark_background</item>
        <item name="colorSecondaryContainer">@color/brand_primary_container</item>
        <item name="colorOnSecondaryContainer">@color/brand_on_primary_container</item>
        <item name="colorTertiary">@color/brand_accent</item>
        <item name="colorError">@color/expense_red</item>
        <item name="colorOnError">@color/brand_on_error</item>
        <item name="colorOutline">@color/dark_outline</item>
        <item name="android:statusBarColor">@color/dark_background</item>
        <item name="android:navigationBarColor">@color/dark_surface</item>
    </style>

    <style name="ThemeOverlay.SpendTracker.Dashboard" parent="ThemeOverlay.Material3">
        <item name="colorSurface">@color/dashboard_dark_surface</item>
        <item name="colorSurfaceContainer">@color/dark_surface_variant</item>
        <item name="colorSurfaceContainerHigh">@color/dark_surface_variant</item>
        <item name="colorSurfaceContainerHighest">@color/dark_surface_variant</item>
        <item name="colorSurfaceVariant">@color/dashboard_dark_surface_variant</item>
        <item name="colorOnSurface">@color/dashboard_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/dashboard_text_secondary</item>
        <item name="colorPrimary">@color/dashboard_brand_primary</item>
        <item name="colorOnPrimary">@color/dashboard_brand_on_primary</item>
        <item name="colorPrimaryContainer">@color/dashboard_brand_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/dashboard_brand_on_primary_container</item>
        <item name="colorSecondary">@color/dashboard_brand_secondary</item>
        <item name="colorOnSecondary">@color/dashboard_dark_background</item>
        <item name="colorSecondaryContainer">@color/dashboard_brand_primary_container</item>
        <item name="colorOnSecondaryContainer">@color/dashboard_brand_on_primary_container</item>
        <item name="colorTertiary">@color/dashboard_brand_accent</item>
        <item name="colorError">@color/dashboard_expense_red</item>
        <item name="colorOnError">@color/dashboard_brand_on_error</item>
        <item name="colorOutline">@color/dashboard_dark_outline</item>
        <item name="android:textColorPrimary">@color/dashboard_text_primary</item>
        <item name="android:textColorSecondary">@color/dashboard_text_secondary</item>
        <item name="colorControlNormal">@color/dashboard_text_secondary</item>
    </style>

    <style name="SettingsWidgetItemStyle">
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">16dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="SettingsWidgetIconStyle">
        <item name="android:layout_width">32dp</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:tint">@color/brand_secondary</item>
    </style>

    <style name="SettingsWidgetLabelStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">12sp</item>
        <item name="android:gravity">center</item>
    </style>
</resources>
