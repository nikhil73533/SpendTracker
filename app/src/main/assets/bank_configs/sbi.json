{
  "bankName": "SBI",
  "patterns": [
    {
      "name": "Account Debit",
      "regex": "(?i)(?:Your\\s+)?A/C\\s+(?:X+)?([0-9]+)\\s+(?:is\\s+)?Debited\\s+(?:by|with|for)\\s+(?:INR|Rs\\.?|₹)?\\s*([0-9,]+(?:\\.[0-9]{1,2})?)",
      "amountGroup": 2,
      "accountGroup": 1,
      "receiverGroup": 0,
      "upiGroup": 0,
      "type": "EXPENSE",
      "sourceType": "Account"
    },
    {
      "name": "Account Credit",
      "regex": "(?i)(?:Your\\s+)?A/C\\s+(?:X+)?([0-9]+)\\s+(?:is\\s+)?Credited\\s+(?:by|with|for)\\s+(?:INR|Rs\\.?|₹)?\\s*([0-9,]+(?:\\.[0-9]{1,2})?)",
      "amountGroup": 2,
      "accountGroup": 1,
      "receiverGroup": 0,
      "upiGroup": 0,
      "type": "INCOME",
      "sourceType": "Account"
    },
    {
      "name": "UPI Transfer Debit",
      "regex": "(?i)SBI\\s+(?:A/C\\s+)?(?:X+)?([0-9]+)\\s+debited\\s+(?:INR|Rs\\.?|₹)\\s*([0-9,]+(?:\\.[0-9]{1,2})?).*?UPI[:\\s]+([0-9]{6,20})",
      "amountGroup": 2,
      "accountGroup": 1,
      "upiGroup": 3,
      "receiverGroup": 0,
      "type": "EXPENSE",
      "sourceType": "Account"
    }
  ]
}
