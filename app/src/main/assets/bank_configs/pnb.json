{
  "bankName": "PNB",
  "senders": ["PNBSMS", "PUNJNB", "PNB"],
  "patterns": [
    {
      "name": "Account Debit",
      "regex": "(?i)(?:Your\\s+)?(?:PNB\\s+)?(?:A/C|A/c|Acct)\\s+(?:XX*)?([0-9]+)\\s+(?:debited|Debited)\\s+(?:by|for|with)\\s+(?:INR|Rs\\.?|₹)?\\s*([0-9,]+(?:\\.[0-9]{1,2})?)",
      "amountGroup": 2,
      "accountGroup": 1,
      "receiverGroup": 0,
      "upiGroup": 0,
      "type": "EXPENSE",
      "sourceType": "Account"
    },
    {
      "name": "Account Credit",
      "regex": "(?i)(?:Your\\s+)?(?:PNB\\s+)?(?:A/C|A/c|Acct)\\s+(?:XX*)?([0-9]+)\\s+(?:credited|Credited)\\s+(?:by|for|with)\\s+(?:INR|Rs\\.?|₹)?\\s*([0-9,]+(?:\\.[0-9]{1,2})?)",
      "amountGroup": 2,
      "accountGroup": 1,
      "receiverGroup": 0,
      "upiGroup": 0,
      "type": "INCOME",
      "sourceType": "Account"
    }
  ]
}
